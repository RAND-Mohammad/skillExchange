<%@ Page Title="Contact Us" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Contact.aspx.cs" Inherits="skillExchange.Contact" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
<div class="container"><div class="jumbotron"><h1>Let's talk</h1><p class="lead">Send a question or suggestion to the Skill Exchange team.</p></div><div class="row"><div class="col-md-8"><div class="panel panel-primary"><div class="panel-heading"><h3 class="panel-title">Send a message</h3></div><div class="panel-body"><asp:ValidationSummary ID="vsContact" runat="server" CssClass="alert alert-danger" ValidationGroup="ContactGroup" /><div class="form-group"><label>Your name</label><asp:TextBox ID="txtName" runat="server" CssClass="form-control" MaxLength="100" /><asp:RequiredFieldValidator ID="rfvName" runat="server" ControlToValidate="txtName" ErrorMessage="Name is required." ForeColor="Red" ValidationGroup="ContactGroup" /></div><div class="form-group"><label>Your email</label><asp:TextBox ID="txtEmail" runat="server" TextMode="Email" CssClass="form-control" MaxLength="150" /><asp:RequiredFieldValidator ID="rfvEmail" runat="server" ControlToValidate="txtEmail" ErrorMessage="Email is required." ForeColor="Red" ValidationGroup="ContactGroup" /><asp:RegularExpressionValidator ID="revEmail" runat="server" ControlToValidate="txtEmail" ValidationExpression="^[^@\s]+@[^@\s]+\.[^@\s]+$" ErrorMessage="Enter a valid email address." ForeColor="Red" ValidationGroup="ContactGroup" /></div><div class="form-group"><label>Message</label><asp:TextBox ID="txtContactMessage" runat="server" TextMode="MultiLine" Rows="5" CssClass="form-control" MaxLength="2000" /><asp:RequiredFieldValidator ID="rfvContactMessage" runat="server" ControlToValidate="txtContactMessage" ErrorMessage="Message is required." ForeColor="Red" ValidationGroup="ContactGroup" /></div><asp:Button ID="btnSend" runat="server" Text="Send Message" CssClass="btn btn-primary" OnClick="btnSend_Click" ValidationGroup="ContactGroup" /> <asp:Label ID="lblContactMessage" runat="server" Font-Bold="true" /></div></div></div><div class="col-md-4"><div class="panel panel-info"><div class="panel-heading"><h3 class="panel-title">Contact details</h3></div><div class="panel-body"><p><strong>Project owner</strong><br />Rand</p><p><strong>Email</strong><br /><a href="mailto:4.rrrrand@gmail.com">4.rrrrand@gmail.com</a></p></div></div></div></div></div>
</asp:Content>
